import os
import shutil

# 1. Configuration - Change these to your actual folder paths
source_dir = "E:/Documents/RGC Project/Data/vla-set-1/vla_first_fits_1"
base_target_dir = "E:/Documents/RGC Project/Data/vla-set-1/Divided_Folders"

# 2. Get list of all .fits files in the directory
# Filter for .fits to avoid moving script itself or other files
files = [f for f in os.listdir(source_dir) if f.endswith('.fits')]
files.sort()  # Optional: ensures files are moved in alphabetical order

# 3. Define the chunk size (6 files per folder)
chunk_size = 6

# 4. Loop through files and move them
for i in range(0, len(files), chunk_size):
    # Calculate folder number (1, 2, 3...)
    folder_number = (i // chunk_size) + 1
    folder_name = f"Folder-{folder_number}"
    
    # Create the full path for the new folder
    new_folder_path = os.path.join(base_target_dir, folder_name)
    
    # Create folder if it doesn't exist
    if not os.path.exists(new_folder_path):
        os.makedirs(new_folder_path)
    
    # Get the next batch of 6 files
    batch = files[i:i + chunk_size]
    
    # Move each file in the batch to the new folder
    for file_name in batch:
        src_path = os.path.join(source_dir, file_name)
        dst_path = os.path.join(new_folder_path, file_name)
        shutil.move(src_path, dst_path)

print(f"Task complete! Distributed {len(files)} files into {folder_number} folders.")
